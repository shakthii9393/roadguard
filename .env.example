# Copy to .env and edit
DATABASE_URL=sqlite:///./roadguard.db
# For PostgreSQL: postgresql+psycopg2://user:pass@localhost:5432/roadguard

# Auth - generate a real secret with: python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET=change-me-to-a-random-64-char-string
JWT_EXPIRE_MINUTES=480

# AI model
MODEL_PATH=backend/ml/weights/best.pt
CONFIDENCE_THRESHOLD=0.35
MAX_UPLOAD_MB=8

# Night Rider: also run a general COCO YOLO model so pedestrians, animals and traffic
# signals are detected without custom training data. Needs `ultralytics`; the weights
# file downloads automatically on first use (or point GENERAL_MODEL_PATH at a local .pt).
USE_GENERAL_MODEL=false
GENERAL_MODEL_PATH=yolov8n.pt

# Routing (public OSRM demo server - fine for development, rate-limited;
# self-host OSRM for production, see README)
OSRM_BASE_URL=https://router.project-osrm.org

# Context-aware collision risk (Night Rider)
# needs USE_GENERAL_MODEL=true; vehicles are live-only, never saved as reports
DETECT_VEHICLES=true
# phone height above the road
CAMERA_HEIGHT_M=1.2
# horizontal field of view of the phone camera
CAMERA_HFOV_DEG=65
# where the horizon sits in the frame (0 = top, 1 = bottom)
HORIZON_Y_RATIO=0.42
# half the width of the corridor your vehicle will sweep
PATH_HALF_WIDTH_M=1.0
# "close to your path" band beyond the corridor
PATH_NEAR_MARGIN_M=1.5
# looping demo road scenarios while no trained model is installed (ignored once you have real weights)
DEMO_SCENARIO=true
